{
  "name": "gugame-backend",
  "version": "1.0.47",
  "description": "Backend API for GuGame",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "tsx --test src/**/*.test.ts",
    "test:integration": "RUN_INTEGRATION_TESTS=1 tsx --test src/**/*.integration.test.ts",
    "test:api": "tsx scripts/api-regression-test.ts",
    "clear:quest-imports": "tsx scripts/clear-quest-import-data.ts",
    "migrate:repeatable-quest-imports": "tsx scripts/allow-repeatable-star-master-imports.ts",
    "migrate:constellations": "tsx scripts/migrate-constellation-system.ts",
    "migrate:main-quest-levels": "tsx scripts/migrate-main-quest-levels.ts --apply",
    "migrate:star-master": "tsx scripts/migrate-star-master-catalog.ts",
    "migrate:sound-v101": "tsx scripts/consolidate-sound-quests-v101.ts",
    "migrate:sound-constellation": "tsx scripts/group-sound-topics-constellation.ts",
    "migrate:baked-boundaries": "tsx scripts/apply-baked-constellation-boundaries.ts",
    "migrate:lighting-to-map-scene": "tsx scripts/move-lighting-topics-to-map-scene.ts",
    "migrate:lighting-guides": "tsx scripts/apply-lighting-constellation-guides.ts",
    "migrate:game-art-system-guides": "tsx scripts/apply-game-art-system-constellation-redesign.ts",
    "migrate:animation-constellation": "tsx scripts/group-animation-constellation.ts",
    "test:load:seed": "tsx scripts/seed-load-test.ts",
    "test:load": "tsx scripts/load-test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@types/multer": "^2.0.0",
    "axios": "^1.6.2",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "discord.js": "^14.25.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "mongoose": "^8.0.3",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/node": "^20.10.5",
    "@types/passport": "^1.0.16",
    "@types/passport-discord": "^0.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
